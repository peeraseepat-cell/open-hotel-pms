NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLEANUP_FUNCTION_SECRET=
SUPABASE_CLEANUP_FUNCTION_URL=

# Cron routes (/api/cron/*). Each route is refused (401) when its secret is unset.
# - ota-alarm, scb-auto-inquiry: Bearer header or ?token=. Per-cron overrides:
#   OTA_ALARM_CRON_SECRET, SCB_AUTO_INQUIRY_CRON_SECRET.
# - linen/rewash/cleanup-expired: Bearer header only.
CRON_SECRET=
# daily-backup, offline-snapshot, ui-event-log-archive: Bearer header or ?token=.
CRON_BACKUP_SECRET=

# Optional: future external housekeeping callbacks
HOUSEKEEPING_WEBHOOK_SECRET=

# LINE Login (same LINE Developers provider as the Messaging API channel)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Optional explicit HMAC secret for LINE Login state cookies.
LINE_LOGIN_STATE_SECRET=

# Google Sheet Sync (Phase 49)
GAS_SYNC_WEB_APP_URL=
GOOGLE_SYNC_API_KEY=

# Phase 72 — Rate Grid Admin Override PIN
# Plaintext bootstrap value; API layer compares request PIN against this
# (or a hashed variant stored in app_settings in a later iteration).
ADMIN_RATE_OVERRIDE_PIN=

# Phase 72 — Telegram Bot (alerts for OTA sync overdue tasks)
# Create bot via @BotFather → paste token here.
TELEGRAM_BOT_TOKEN=
# Random high-entropy string; appears in webhook URL path as
# /api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET> and is also sent by
# Telegram via X-Telegram-Bot-Api-Secret-Token header for verification.
TELEGRAM_WEBHOOK_SECRET=
# Admin chat id (numeric) — fallback when app_settings.telegram.admin_chat_id
# is not yet configured through /pms/setup/rates/admin.
TELEGRAM_ADMIN_CHAT_ID=
